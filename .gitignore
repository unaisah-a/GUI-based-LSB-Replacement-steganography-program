# Based on README section 22, with two additions noted below.

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.venv/
venv/
env/
*.egg-info/

# Test and type-checker caches (not in README section 22, but these are
# generated by the pytest/hypothesis setup the image layer uses).
.pytest_cache/
.hypothesis/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db
desktop.ini

# Temporary/generated media
output/
temp/
tmp/
*.tmp

# Logs
*.log

# Private keys
#
# README section 22 suggests `keys/private/`, but the folder created by the
# project structure is `keys/demo_private/`, so both are listed.
#
# Deviation worth a team decision: section 22 also ignores `*.pem` and `*.key`
# outright, which would exclude PUBLIC keys as well. The receiver side of the
# A-to-B demo needs the public key, so `keys/public/` is explicitly re-included
# below. Private key material is still ignored everywhere else.
keys/private/
keys/demo_private/
*.pem
*.key
*.p12
*.pfx

# Keep the committed folder placeholders and allow public keys to be shared.
!keys/**/.gitkeep
!keys/public/
!keys/public/*.pem

# Generated evidence artefacts. The folders are kept via .gitkeep so the
# structure survives, but large screenshots and logs stay out of Git unless a
# member adds one deliberately with `git add -f`.
evidence/logs/*
evidence/results/*
!evidence/**/.gitkeep
