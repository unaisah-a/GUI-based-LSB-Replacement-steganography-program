# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.venv/
.venv-*/
venv/
env/
*.egg-info/

# Test and type-checker caches
.pytest_cache/
.hypothesis/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# IDE
.vscode/*
!.vscode/extensions.json
.idea/
*.swp

# OS
.DS_Store
Thumbs.db
desktop.ini

# Temporary/generated media
output/
temp/
tmp/
*.tmp

# Logs
*.log
*.log.[0-9]*

# Captured test-run output (pytest stdout redirected to a file so long runs can
# be inspected without flooding a terminal).
.pytest_out.txt

# Private keys stay local; public keys can be shared.
keys/private/
keys/demo_private/
*.pem
*.key
*.p12
*.pfx
!keys/public/
!keys/public/*.pem
keys/public/demo_public.pem

# Keep verification evidence under version control.

# Built submission archives (scripts/package_submission.py).
dist/
